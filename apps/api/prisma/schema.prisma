generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REPORTER
  TECHNICIAN
  FACILITY_MANAGER
  ADMIN
}

enum LocationType {
  CAMPUS
  BUILDING
  FLOOR
  ROOM
}

enum AssetStatus {
  ACTIVE
  FAULTY
  REPAIRING
  MAINTENANCE
  RETIRED
}

enum IncidentStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_PARTS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  REOPENED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum AttachmentKind {
  INCIDENT
  BEFORE_REPAIR
  AFTER_REPAIR
  MAINTENANCE
  DOCUMENT
}

enum RecurrenceType {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MaintenanceTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum NotificationType {
  INCIDENT_CREATED
  INCIDENT_ASSIGNED
  INCIDENT_UPDATED
  COMMENT_ADDED
  DEADLINE_WARNING
  OVERDUE
  MAINTENANCE_DUE
  LOW_STOCK
  SYSTEM
}

model User {
  id                    String               @id @default(cuid())
  fullName              String
  email                 String               @unique
  passwordHash          String
  role                  Role                 @default(REPORTER)
  department            String?
  phone                 String?
  avatarUrl             String?
  active                Boolean              @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sessions              Session[]
  reportedIncidents     Incident[]           @relation("ReporterIncidents")
  assignedIncidents     Incident[]           @relation("AssignedIncidents")
  statusHistory         IncidentStatusHistory[]
  comments              IncidentComment[]
  attachments           Attachment[]
  notifications         Notification[]
  assignmentsReceived   IncidentAssignment[] @relation("AssignmentTechnician")
  assignmentsCreated    IncidentAssignment[] @relation("AssignmentActor")
  transfers             AssetTransfer[]
  uploadedDocuments     AssetDocument[]
  ratings               IncidentRating[]
  maintenancePlans      MaintenancePlan[]    @relation("PlanTechnician")
  createdPlans          MaintenancePlan[]    @relation("PlanCreator")
  maintenanceTasks      MaintenanceTask[]    @relation("TaskTechnician")
  stockTransactions     StockTransaction[]
  auditLogs             AuditLog[]
  updatedPriorityTarget PriorityTarget[]

  @@index([role, active])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Location {
  id            String          @id @default(cuid())
  name          String
  code          String          @unique
  type          LocationType
  parentId      String?
  description   String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  parent        Location?       @relation("LocationTree", fields: [parentId], references: [id])
  children      Location[]      @relation("LocationTree")
  assets        Asset[]
  transfersFrom AssetTransfer[] @relation("TransferFrom")
  transfersTo   AssetTransfer[] @relation("TransferTo")

  @@index([parentId, active])
  @@index([type])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assets      Asset[]
}

model Asset {
  id               String      @id @default(cuid())
  assetCode        String      @unique
  name             String
  categoryId       String
  locationId       String
  manufacturer     String?
  model            String?
  serialNumber     String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?    @db.Decimal(14, 2)
  warrantyUntil    DateTime?
  status           AssetStatus @default(ACTIVE)
  imageUrl         String?
  description      String?
  qrToken          String      @unique
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  category         AssetCategory @relation(fields: [categoryId], references: [id])
  location         Location      @relation(fields: [locationId], references: [id])
  incidents        Incident[]
  transfers        AssetTransfer[]
  documents        AssetDocument[]
  maintenancePlans MaintenancePlan[]
  maintenanceTasks MaintenanceTask[]

  @@index([status, locationId])
  @@index([categoryId, active])
}

model AssetTransfer {
  id              String    @id @default(cuid())
  assetId         String
  fromLocationId  String?
  toLocationId    String
  reason          String
  transferredById String
  transferredAt   DateTime  @default(now())
  asset           Asset     @relation(fields: [assetId], references: [id])
  fromLocation    Location? @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation      Location  @relation("TransferTo", fields: [toLocationId], references: [id])
  transferredBy   User      @relation(fields: [transferredById], references: [id])

  @@index([assetId, transferredAt])
}

model AssetDocument {
  id           String   @id @default(cuid())
  assetId      String
  fileName     String
  fileUrl      String
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())
  asset        Asset    @relation(fields: [assetId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model Incident {
  id                   String         @id @default(cuid())
  incidentCode         String         @unique
  assetId              String
  reporterId           String
  assignedTechnicianId String?
  title                String
  description          String
  category             String?
  priority             Priority       @default(MEDIUM)
  status               IncidentStatus @default(NEW)
  firstRespondedAt     DateTime?
  dueAt                DateTime?
  resolvedAt           DateTime?
  completedAt          DateTime?
  rootCause            String?
  resolution           String?
  laborCost            Decimal?       @db.Decimal(12, 2)
  externalCost         Decimal?       @db.Decimal(12, 2)
  aiSuggestion         Json?
  aiAccepted           Boolean?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  asset                Asset          @relation(fields: [assetId], references: [id])
  reporter             User           @relation("ReporterIncidents", fields: [reporterId], references: [id])
  assignedTechnician   User?          @relation("AssignedIncidents", fields: [assignedTechnicianId], references: [id])
  assignments          IncidentAssignment[]
  history              IncidentStatusHistory[]
  comments             IncidentComment[]
  attachments          Attachment[]
  rating               IncidentRating?
  parts                IncidentPart[]
  stockTransactions    StockTransaction[]

  @@index([status, priority])
  @@index([assetId, createdAt])
  @@index([reporterId, createdAt])
  @@index([assignedTechnicianId, status])
  @@index([dueAt, status])
}

model IncidentAssignment {
  id           String    @id @default(cuid())
  incidentId   String
  technicianId String
  assignedById String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  note         String?
  incident     Incident  @relation(fields: [incidentId], references: [id])
  technician   User      @relation("AssignmentTechnician", fields: [technicianId], references: [id])
  assignedBy   User      @relation("AssignmentActor", fields: [assignedById], references: [id])

  @@index([incidentId, assignedAt])
  @@index([technicianId, unassignedAt])
}

model IncidentStatusHistory {
  id         String         @id @default(cuid())
  incidentId String
  actorId    String
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  note       String?
  createdAt  DateTime       @default(now())
  incident   Incident       @relation(fields: [incidentId], references: [id])
  actor      User           @relation(fields: [actorId], references: [id])

  @@index([incidentId, createdAt])
}

model IncidentComment {
  id           String   @id @default(cuid())
  incidentId   String
  authorId     String
  content      String
  internalOnly Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  incident     Incident @relation(fields: [incidentId], references: [id])
  author       User     @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
}

model Attachment {
  id                String           @id @default(cuid())
  incidentId        String?
  maintenanceTaskId String?
  uploadedById      String
  fileName          String
  fileUrl           String
  mimeType          String
  fileSize          Int
  kind              AttachmentKind   @default(INCIDENT)
  createdAt         DateTime         @default(now())
  incident          Incident?        @relation(fields: [incidentId], references: [id])
  maintenanceTask   MaintenanceTask? @relation(fields: [maintenanceTaskId], references: [id])
  uploadedBy        User             @relation(fields: [uploadedById], references: [id])

  @@index([incidentId])
  @@index([maintenanceTaskId])
}

model IncidentRating {
  id         String   @id @default(cuid())
  incidentId String   @unique
  reporterId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
  reporter   User     @relation(fields: [reporterId], references: [id])
}

model MaintenancePlan {
  id                   String         @id @default(cuid())
  assetId              String
  name                 String
  description          String?
  recurrenceType       RecurrenceType
  interval             Int            @default(1)
  startDate            DateTime
  nextDueAt            DateTime
  assignedTechnicianId String?
  active               Boolean        @default(true)
  checklist            Json
  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  asset                Asset          @relation(fields: [assetId], references: [id])
  assignedTechnician   User?          @relation("PlanTechnician", fields: [assignedTechnicianId], references: [id])
  createdBy            User           @relation("PlanCreator", fields: [createdById], references: [id])
  tasks                MaintenanceTask[]

  @@index([nextDueAt, active])
}

model MaintenanceTask {
  id              String                @id @default(cuid())
  planId          String
  assetId         String
  technicianId    String?
  dueAt           DateTime
  status          MaintenanceTaskStatus @default(PENDING)
  checklistResult Json?
  completedAt     DateTime?
  note            String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  plan            MaintenancePlan       @relation(fields: [planId], references: [id])
  asset           Asset                 @relation(fields: [assetId], references: [id])
  technician      User?                 @relation("TaskTechnician", fields: [technicianId], references: [id])
  attachments     Attachment[]

  @@unique([planId, dueAt])
  @@index([dueAt, status])
  @@index([technicianId, status])
}

model Part {
  id              String   @id @default(cuid())
  partCode        String   @unique
  name            String
  category        String
  unit            String
  quantity        Int      @default(0)
  minimumQuantity Int      @default(0)
  unitPrice       Decimal  @default(0) @db.Decimal(12, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  transactions    StockTransaction[]
  incidentParts   IncidentPart[]

  @@index([active, quantity])
}

model StockTransaction {
  id         String               @id @default(cuid())
  partId     String
  type       StockTransactionType
  quantity   Int
  unitPrice  Decimal?             @db.Decimal(12, 2)
  incidentId String?
  actorId    String
  note       String?
  createdAt  DateTime             @default(now())
  part       Part                 @relation(fields: [partId], references: [id])
  incident   Incident?            @relation(fields: [incidentId], references: [id])
  actor      User                 @relation(fields: [actorId], references: [id])

  @@index([partId, createdAt])
  @@index([incidentId])
}

model IncidentPart {
  id                String   @id @default(cuid())
  incidentId        String
  partId            String
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  incident          Incident @relation(fields: [incidentId], references: [id])
  part              Part     @relation(fields: [partId], references: [id])

  @@index([incidentId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(SYSTEM)
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model PriorityTarget {
  id                String   @id @default(cuid())
  priority          Priority @unique
  responseMinutes   Int
  resolutionMinutes Int
  warningPercent    Int      @default(80)
  updatedById       String
  updatedAt         DateTime @updatedAt
  updatedBy         User     @relation(fields: [updatedById], references: [id])
}
